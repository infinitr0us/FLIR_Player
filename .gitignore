# ---------------------------------------------------------------------------
# FLIR Thermal Player — .gitignore
# ---------------------------------------------------------------------------

# --- FLIR File SDK (proprietary, EAR99 export-controlled) --------------------
# Never commit the SDK wheels or any FLIR native binaries. They are not ours to
# redistribute. Users must obtain the SDK from FLIR/Teledyne themselves.
*.whl
fnv/
FileSDK*/

# --- Thermal recordings / sample data (large, not ours to publish) ----------
*.ats
*.seq
*.csq
*.sfmov
*.fff
*.ptw

# --- Third-party copyrighted docs -------------------------------------------
FLIR_ResearchIR_User_Manual.pdf

# --- Build / packaging output (regenerated by build_exe.bat) ----------------
build/
release/
dist/
*.exe

# --- Internal dev / QA screenshots ------------------------------------------
artifacts/

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# --- Editors / IDEs ----------------------------------------------------------
.idea/
.vscode/
*.swp

# --- OS cruft ----------------------------------------------------------------
Thumbs.db
Desktop.ini
.DS_Store
